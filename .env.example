# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Arc (testnet) ---
ARC_CHAIN_ID=5042002
# Personal Canteen RPC (from `arc-canteen rpc-url`); public fallback: https://rpc.testnet.arc.io
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_EXPLORER_URL=https://testnet.arcscan.app
# USDC ERC-20 interface on Arc (6 decimals)
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- Dev wallet (arc-canteen testnet wallet) ---
DEV_WALLET_ADDRESS=
# Only needed from day 4 (contract deploys). Copy from ~/.arc-canteen/wallet.yaml.
DEPLOYER_PRIVATE_KEY=

# --- Circle ---
# Agent wallets (Circle CLI) log in with an email one-time code: no key needed here.
# Only needed if we use developer-controlled wallets from code instead:
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# --- AI operator ---
# gemini (default) or claude. Both are supported; pick with OPERATOR_PROVIDER.
OPERATOR_PROVIDER=gemini
# Optional model override (defaults: gemini-3.1-flash-lite, claude-opus-5)
OPERATOR_MODEL=
# Used for a whole run when the default Gemini model's daily quota is used up (docs/evals/operator-models.md)
OPERATOR_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
BURSAR_API_URL=http://127.0.0.1:8787

# --- Seller (our x402 service) ---
SELLER_ADDRESS=
SELLER_PRIVATE_KEY=
SELLER_PORT=4021

# --- Circle agent wallet (from `circle wallet list --chain ARC-TESTNET`) ---
AGENT_WALLET_ADDRESS=

# --- Postgres (docker compose up -d) ---
DATABASE_URL=postgres://bursar:bursar@127.0.0.1:54330/bursar
TEST_DATABASE_URL=postgres://bursar:bursar@127.0.0.1:54330/bursar_test

# --- Operator (Bursar's server key: releases within job rules, anchors the audit log) ---
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=

# --- Deployed contracts (from contracts/deployments/<chainId>.json) ---
JOB_VAULT_ADDRESS=
AUDIT_ANCHOR_ADDRESS=
# The worker anchors the audit log head this often (ms) when there's anything new, or after this many entries
ANCHOR_INTERVAL_MS=600000
ANCHOR_EVERY_ENTRIES=50

# --- Worker / API ---
JOB_VAULT_DEPLOY_BLOCK=
# Local development only: lets agents buy from a seller on 127.0.0.1. Never true in production.
ALLOW_PRIVATE_PAYEES=false
API_PORT=8787

# --- Dev customer wallet (test-only; pays revenue into jobs with onchain:pay) ---
DEV_CUSTOMER_ADDRESS=
DEV_CUSTOMER_PRIVATE_KEY=

# --- Dev approver wallet (test-only; signs approvals with dev:approve) ---
DEV_APPROVER_ADDRESS=
DEV_APPROVER_PRIVATE_KEY=

# --- Console (apps/web) ---
# Where the console runs, comma-separated. The API allows these origins and accepts wallet sign-ins for them.
WEB_ORIGINS=http://localhost:5173
# Only VITE_* values reach the browser. WalletConnect project ID from cloud.reown.com (for phone wallets).
VITE_WALLETCONNECT_PROJECT_ID=
# Optional; defaults to http://127.0.0.1:8787 and the Arc testnet contracts.
VITE_API_URL=

# --- Alerts and autopilot (worker) ---
# Links in alerts point here.
WEB_URL=http://localhost:5173
# Telegram alerts: create a bot with @BotFather. The worker needs the token; the API needs the bot's @username (without @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Local development only: let webhooks reach 127.0.0.1.
ALLOW_PRIVATE_WEBHOOKS=false
# Automatic operator runs (needs GEMINI_API_KEY or ANTHROPIC_API_KEY). Set to false to turn off.
AUTOPILOT=true
